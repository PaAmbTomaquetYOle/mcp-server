MCP_SERVER_NAME=OffBoardMe-mcp
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_SERVER_LOG_LEVEL=INFO
MCP_SERVER_DEBUG=false

# Externally accessible URL of this server.
# The OAuth callback URI is derived automatically as {base_url}/callback.
# Default (if unset): http://localhost:{port}
# For remote deployments, set to the public URL (e.g. https://mcp.example.com)
MCP_SERVER_BASE_URL=

# Jira OAuth 2.0 (3LO) configuration
# Setup steps:
#   1. Go to https://developer.atlassian.com/console/myapps/
#   2. Create a new app -> select "OAuth 2.0 (3LO)"
#   3. Under "Authorization", set callback URL to {base_url}/callback
#   4. Under "Permissions", add scopes: read:me, read:jira-work, read:jira-user
#   5. Copy Client ID and Client Secret from the app settings
MCP_SERVER_JIRA_CLIENT_ID=
MCP_SERVER_JIRA_CLIENT_SECRET=

# Your Jira instance URL (e.g. https://your-domain.atlassian.net)
MCP_SERVER_JIRA_SERVER_URL=https://your-domain.atlassian.net

# Cloud ID: visit https://your-domain.atlassian.net/_edge/tenant_info to find it
MCP_SERVER_JIRA_CLOUD_ID=

MCP_SERVER_JIRA_TOKEN_DB_PATH=data/tokens.db

# Trello OAuth 1.0a configuration
# Setup steps:
#   1. Log in to Trello and go to https://trello.com/power-ups/admin
#   2. Select the Workspace where you are admin, then click "New"
#   3. Fill in the form:
#        - Name: your app name (e.g. OffBoardMe)
#        - Workspace: select your workspace
#        - Iframe connector URL (required): any HTTPS URL (e.g. https://example.com)
#   4. After saving, open your Power-Up and go to the "API Key" tab
#   5. Click "Generate a new API key"
#   6. Copy the API Key → MCP_SERVER_TRELLO_API_KEY
#   7. On the same page, copy the Secret → MCP_SERVER_TRELLO_API_SECRET
#   8. Still on the "API Key" tab, under "Allowed Origins", add your server's
#      origin (e.g. http://localhost:8000). Without this, redirect URLs won't work.
#
# Docs: https://developer.atlassian.com/cloud/trello/guides/rest-api/api-introduction/
MCP_SERVER_TRELLO_API_KEY=
MCP_SERVER_TRELLO_API_SECRET=
MCP_SERVER_TRELLO_APP_NAME=OffBoardMe

# OffBoardMe backend API — used by the dossier/SOP tools (read-only REST).
# The client obtains a token via POST {url}/auth/token (client-credentials) and caches it.
# client_id/secret must match a service account in the backend's SERVICE_CREDENTIALS.
MCP_SERVER_BACKEND_API_URL=http://localhost:8001/api/v1
MCP_SERVER_BACKEND_CLIENT_ID=mcp-server
MCP_SERVER_BACKEND_CLIENT_SECRET=

# Slack Enterprise Search connector (see docs.slack.dev/enterprise-search)
# The bot token is used to call functions.completeSuccess/completeError,
# apps.user.connection.update, and entity.presentDetails.
MCP_SERVER_SLACK_BOT_TOKEN=
# Signing secret used to verify POST /slack/events requests (HMAC-SHA256).
MCP_SERVER_SLACK_SIGNING_SECRET=
# How often (seconds) the SOP search cache is refreshed from the backend.
MCP_SERVER_SOP_CACHE_TTL_SECONDS=60
# Base URL for SOP deep links shown in Slack search results.
# Default (if unset): {base_url}/sops
MCP_SERVER_SOP_BASE_URL=

# generate_dossier tool — LLM that writes offboarding dossier content.
# The backend's LLMDossierGenerator calls this tool instead of hosting a model
# itself; the model, prompt, and its own context tools (search_prior_dossiers,
# search_sops) all live here.
MCP_SERVER_ANTHROPIC_API_KEY=
MCP_SERVER_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
MCP_SERVER_DOSSIER_GENERATION_MAX_TOOL_ITERATIONS=4
MCP_SERVER_DOSSIER_GENERATION_MAX_TOKENS=4096

# Slack OAuth 2.0 user token — required for the Real-Time Search API
# (assistant.search.context), which can only be called proactively with a
# user token (xoxp-). Requested user scopes: search:read.public/.private/.im/
# .mpim/.files/.users. Setup:
#   1. Go to https://api.slack.com/apps -> your app -> "OAuth & Permissions"
#   2. Under "Redirect URLs", add {base_url}/slack/oauth/callback
#   3. Under "User Token Scopes", add the search:read.* scopes above
#   4. Copy the Client ID and Client Secret from "Basic Information"
MCP_SERVER_SLACK_CLIENT_ID=
MCP_SERVER_SLACK_CLIENT_SECRET=
# Default (if unset): {base_url}/slack/oauth/callback
MCP_SERVER_SLACK_REDIRECT_URI=
